{# templates/pagination/pagination.html.twig #}
{% if pageCount > 1 %}
<nav aria-label="Pagination" class="my-5">
    <ul class="pagination justify-content-center mb-4">
        {# Previous #}
        {% if previous is defined %}
            <li class="page-item">
                <a class="page-link" href="{{ path(route, query|merge({(pageParameterName): previous})) }}" rel="prev">
                    <i class="bi bi-chevron-left"></i> Précédent
                </a>
            </li>
        {% else %}
            <li class="page-item disabled">
                <span class="page-link"><i class="bi bi-chevron-left"></i> Précédent</span>
            </li>
        {% endif %}

        {# Pages #}
        {% if startPage > 1 %}
            <li class="page-item">
                <a class="page-link" href="{{ path(route, query|merge({(pageParameterName): 1})) }}">1</a>
            </li>
            {% if startPage > 2 %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}
        {% endif %}

        {% for page in pagesInRange %}
            {% if page == current %}
                <li class="page-item active">
                    <span class="page-link">{{ page }}</span>
                </li>
            {% else %}
                <li class="page-item">
                    <a class="page-link" href="{{ path(route, query|merge({(pageParameterName): page})) }}">{{ page }}</a>
                </li>
            {% endif %}
        {% endfor %}

        {% if endPage < pageCount %}
            {% if endPage < pageCount - 1 %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}
            <li class="page-item">
                <a class="page-link" href="{{ path(route, query|merge({(pageParameterName): pageCount})) }}">{{ pageCount }}</a>
            </li>
        {% endif %}

        {# Next #}
        {% if next is defined %}
            <li class="page-item">
                <a class="page-link" href="{{ path(route, query|merge({(pageParameterName): next})) }}" rel="next">
                    Suivant <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        {% else %}
            <li class="page-item disabled">
                <span class="page-link">Suivant <i class="bi bi-chevron-right"></i></span>
            </li>
        {% endif %}
    </ul>

    <p class="text-center text-muted small mt-3">
        Page {{ current }} sur {{ pageCount }} — {{ totalCount }} article(s) au total
    </p>
</nav>
{% endif %}
