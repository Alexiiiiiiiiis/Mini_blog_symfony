<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mon Blog Symfony{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
        }
        body { background-color: #f8f9fa; font-family: 'Segoe UI', sans-serif; }
        .navbar-brand { font-weight: 700; font-size: 1.4rem; color: var(--primary) !important; }
        .navbar { background: white; box-shadow: 0 2px 10px rgba(0,0,0,.08); }
        .btn-primary { background: var(--primary); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
        .card { border: none; box-shadow: 0 2px 12px rgba(0,0,0,.07); transition: transform .2s; }
        .card:hover { transform: translateY(-3px); }
        .badge-category { background: var(--primary); }
        .post-img { height: 200px; object-fit: cover; width: 100%; }
        .sidebar-card { background: white; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,.07); }
        footer { background: #1e1e2e; color: #aaa; padding: 2rem 0; margin-top: 4rem; }
        .admin-sidebar { min-height: 100vh; background: #1e1e2e; }
        .admin-sidebar .nav-link { color: #aaa; padding: .75rem 1.25rem; border-radius: 8px; margin: 2px 0; }
        .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active { background: var(--primary); color: white; }
        .admin-sidebar .nav-link i { margin-right: 8px; }
        .stat-card { border-radius: 16px; padding: 1.5rem; color: white; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

{% if not (app.request.pathInfo starts with '/admin') %}
<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <i class="bi bi-journal-richtext"></i> MonBlog
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link {{ app.request.pathInfo == '/' ? 'fw-bold text-primary' : '' }}" href="{{ path('app_home') }}">
                        <i class="bi bi-house"></i> Accueil
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav">
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link text-warning" href="{{ path('admin_dashboard') }}">
                            <i class="bi bi-speedometer2"></i> Administration
                        </a>
                    </li>
                    {% endif %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            {% if app.user.profilePicture %}
                                <img src="{{ app.user.profilePicture }}" class="rounded-circle" width="28" height="28" style="object-fit:cover">
                            {% else %}
                                <i class="bi bi-person-circle"></i>
                            {% endif %}
                            {{ app.user.firstName }}
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="bi bi-person me-2"></i>Mon profil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                                </a>
                            </li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}"><i class="bi bi-box-arrow-in-right"></i> Connexion</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary ms-2" href="{{ path('app_register') }}">S'inscrire</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
{% endif %}

{% for type, messages in app.flashes %}
    <div class="container mt-3">
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    </div>
{% endfor %}

{% block body %}{% endblock %}

<footer>
    <div class="container text-center">
        <p class="mb-0">&copy; {{ "now"|date("Y") }} MonBlog — Projet Symfony Alexis</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
