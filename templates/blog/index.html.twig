{% extends 'base.html.twig' %}

{% block title %}Accueil — MonBlog{% endblock %}

{% block body %}
<!-- Hero -->
<section class="py-5 text-white text-center" style="background: linear-gradient(135deg, #6366f1, #8b5cf6);">
    <div class="container">
        <h1 class="display-5 fw-bold mb-3"><i class="bi bi-journal-richtext"></i> MonBlog</h1>
        <p class="lead mb-4">Découvrez nos derniers articles, conseils et actualités.</p>
        <form action="{{ path('app_home') }}" method="get" class="d-flex justify-content-center gap-2">
            <input type="text" name="q" class="form-control w-50" placeholder="Rechercher un article..." value="{{ search ?? '' }}">
            <button class="btn btn-light fw-bold">Rechercher</button>
        </form>
    </div>
</section>

<div class="container py-5">
    <div class="row">
        <!-- Articles -->
        <div class="col-lg-8">
            {% if search %}
                <h5 class="mb-4 text-muted">Résultats pour "<strong>{{ search }}</strong>" — {{ posts|length }} article(s)</h5>
            {% endif %}

            {% if posts is empty %}
                <div class="text-center py-5">
                    <i class="bi bi-journal-x" style="font-size: 4rem; color: #ccc;"></i>
                    <p class="mt-3 text-muted">Aucun article disponible pour le moment.</p>
                </div>
            {% else %}
                <div class="row g-4">
                {% for post in posts %}
                    <div class="col-md-6">
                        <div class="card h-100">
                            {% if post.picture %}
                                <img src="{{ post.picture }}" class="post-img card-img-top" alt="{{ post.title }}">
                            {% else %}
                                <div class="post-img d-flex align-items-center justify-content-center bg-gradient" style="background: linear-gradient(135deg, #e0e7ff, #c7d2fe);">
                                    <i class="bi bi-image" style="font-size: 3rem; color: #a5b4fc;"></i>
                                </div>
                            {% endif %}
                            <div class="card-body d-flex flex-column">
                                {% if post.category %}
                                    <span class="badge badge-category mb-2" style="width: fit-content;">{{ post.category.name }}</span>
                                {% endif %}
                                <h5 class="card-title">
                                    <a href="{{ path('app_post_show', {id: post.id}) }}" class="text-decoration-none text-dark">
                                        {{ post.title }}
                                    </a>
                                </h5>
                                <p class="card-text text-muted flex-grow-1">{{ post.excerpt }}</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <small class="text-muted">
                                        <i class="bi bi-person"></i> {{ post.author.fullName }}
                                    </small>
                                    <small class="text-muted">
                                        <i class="bi bi-calendar3"></i> {{ post.publishedAt|date('d/m/Y') }}
                                    </small>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-muted">
                                        <i class="bi bi-chat"></i> {{ post.approvedComments|length }} commentaire(s)
                                    </small>
                                    <a href="{{ path('app_post_show', {id: post.id}) }}" class="btn btn-sm btn-outline-primary">
                                        Lire <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                </div>
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="sidebar-card">
                <h6 class="fw-bold mb-3"><i class="bi bi-grid"></i> Catégories</h6>
                <a href="{{ path('app_home') }}" class="btn btn-sm {{ not currentCategory ? 'btn-primary' : 'btn-outline-secondary' }} me-1 mb-2">
                    Toutes
                </a>
                {% for cat in categories %}
                    <a href="{{ path('app_home', {category: cat.id}) }}"
                       class="btn btn-sm {{ currentCategory == cat.id ? 'btn-primary' : 'btn-outline-secondary' }} me-1 mb-2">
                        {{ cat.name }}
                        <span class="badge bg-secondary ms-1">{{ cat.posts|length }}</span>
                    </a>
                {% endfor %}
            </div>

            {% if not app.user %}
            <div class="sidebar-card text-center" style="background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white;">
                <i class="bi bi-person-plus" style="font-size: 2.5rem;"></i>
                <h6 class="mt-2 fw-bold">Rejoignez la communauté</h6>
                <p class="small mb-3">Inscrivez-vous pour commenter les articles.</p>
                <a href="{{ path('app_register') }}" class="btn btn-light btn-sm fw-bold">S'inscrire gratuitement</a>
            </div>
            {% else %}
            <div class="sidebar-card text-center">
                {% if app.user.profilePicture %}
                    <img src="{{ app.user.profilePicture }}" class="rounded-circle mb-2" width="60" height="60" style="object-fit:cover">
                {% else %}
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto mb-2" style="width:60px;height:60px;">
                        <span class="text-white fw-bold fs-4">{{ app.user.firstName|first|upper }}</span>
                    </div>
                {% endif %}
                <h6 class="fw-bold">{{ app.user.fullName }}</h6>
                <p class="small text-muted">{{ app.user.createdAt|date('d/m/Y') }}</p>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
