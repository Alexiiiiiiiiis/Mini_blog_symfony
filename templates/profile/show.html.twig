{% extends 'base.html.twig' %}

{% block title %}Mon Profil — MonBlog{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card p-4">
                <div class="text-center mb-4">
                    {% if user.profilePicture %}
                        <img src="{{ user.profilePicture }}" class="rounded-circle mb-3" width="100" height="100" style="object-fit: cover;" alt="{{ user.fullName }}">
                    {% else %}
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto mb-3" style="width:100px;height:100px;">
                            <span class="text-white fw-bold fs-1">{{ user.firstName|first|upper }}</span>
                        </div>
                    {% endif %}
                    <h3 class="fw-bold">{{ user.fullName }}</h3>
                    <span class="badge {{ user.isAdmin ? 'bg-warning text-dark' : 'bg-primary' }}">
                        {{ user.isAdmin ? 'Administrateur' : 'Utilisateur' }}
                    </span>
                </div>

                <table class="table table-borderless">
                    <tr>
                        <td class="fw-semibold text-muted" width="40%"><i class="bi bi-envelope me-2"></i>Email</td>
                        <td>{{ user.email }}</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted"><i class="bi bi-calendar3 me-2"></i>Membre depuis</td>
                        <td>{{ user.createdAt|date('d/m/Y') }}</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted"><i class="bi bi-chat me-2"></i>Commentaires</td>
                        <td>{{ user.comments|length }}</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold text-muted"><i class="bi bi-heart-fill text-danger me-2"></i>Articles aimés</td>
                        <td>{{ user.likes|length }}</td>
                    </tr>
                </table>
    
                <div class="d-flex gap-2 mt-3">
                    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Modifier mon profil
                    </a>
                    <a href="{{ path('app_profile_liked_posts') }}" class="btn btn-outline-danger">
                        <i class="bi bi-heart-fill"></i> Mes articles aimés
                    </a>
                    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}