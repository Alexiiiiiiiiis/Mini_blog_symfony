<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin — MonBlog{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root { --primary: #6366f1; }
        body { background: #f0f2f5; }
        .admin-sidebar { min-height: 100vh; background: #1e1e2e; width: 260px; position: fixed; top: 0; left: 0; z-index: 100; overflow-y: auto; }
        .admin-sidebar .brand { padding: 1.5rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,.08); }
        .admin-sidebar .brand span { font-size: 1.2rem; font-weight: 700; color: white; }
        .admin-sidebar .nav-link { color: rgba(255,255,255,.6); padding: .7rem 1.25rem; border-radius: 8px; margin: 2px 8px; transition: all .2s; display: flex; align-items: center; gap: .6rem; }
        .admin-sidebar .nav-link:hover { background: rgba(255,255,255,.1); color: white; }
        .admin-sidebar .nav-link.active { background: var(--primary); color: white; }
        .admin-sidebar .nav-section { color: rgba(255,255,255,.3); font-size: .7rem; text-transform: uppercase; letter-spacing: 1px; padding: 1rem 1.35rem .3rem; }
        .admin-content { margin-left: 260px; min-height: 100vh; }
        .admin-topbar { background: white; padding: .9rem 1.5rem; box-shadow: 0 1px 5px rgba(0,0,0,.06); display: flex; justify-content: space-between; align-items: center; }
        .stat-card { border-radius: 16px; padding: 1.5rem; color: white; border: none; }
        .table th { background: #f8f9fa; font-size: .85rem; font-weight: 600; color: #6c757d; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

<!-- Sidebar -->
<aside class="admin-sidebar">
    <div class="brand d-flex align-items-center gap-2">
        <i class="bi bi-journal-richtext text-primary fs-4"></i>
        <span>MonBlog Admin</span>
    </div>
    <nav class="mt-2">
        <div class="nav-section">Navigation</div>
        <a href="{{ path('admin_dashboard') }}" class="nav-link {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
            <i class="bi bi-speedometer2"></i> Tableau de bord
        </a>

        <div class="nav-section">Contenu</div>
        <a href="{{ path('admin_posts') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_post' ? 'active' : '' }}">
            <i class="bi bi-file-earmark-text"></i> Articles
        </a>
        <a href="{{ path('admin_categories') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_categor' ? 'active' : '' }}">
            <i class="bi bi-grid-3x3-gap"></i> Catégories
        </a>
        <a href="{{ path('admin_comments') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_comment' ? 'active' : '' }}">
            <i class="bi bi-chat-dots"></i> Commentaires
        </a>

        <div class="nav-section">Utilisateurs</div>
        <a href="{{ path('admin_users') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_user' ? 'active' : '' }}">
            <i class="bi bi-people"></i> Utilisateurs
        </a>

        <div class="nav-section mt-4">Compte</div>
        <a href="{{ path('app_home') }}" class="nav-link">
            <i class="bi bi-globe"></i> Voir le blog
        </a>
        <a href="{{ path('app_logout') }}" class="nav-link text-danger-emphasis">
            <i class="bi bi-box-arrow-right"></i> Déconnexion
        </a>
    </nav>
</aside>

<!-- Main Content -->
<div class="admin-content">
    <div class="admin-topbar">
        <h6 class="mb-0 fw-semibold">{% block page_title %}Dashboard{% endblock %}</h6>
        <div class="d-flex align-items-center gap-2">
            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width:34px;height:34px;">
                <span class="text-white fw-bold small">{{ app.user.firstName|first|upper }}</span>
            </div>
            <span class="small fw-semibold">{{ app.user.fullName }}</span>
            <span class="badge bg-warning text-dark">Admin</span>
        </div>
    </div>

    <div class="p-4">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
