{% extends 'admin/base.html.twig' %}

{% block title %}Utilisateurs — Admin{% endblock %}
{% block page_title %}Gestion des utilisateurs{% endblock %}

{% block content %}
<h5 class="mb-4 fw-bold">{{ users|length }} utilisateur(s) inscrit(s)</h5>

<div class="card">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Statut</th>
                <th>Inscription</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td class="text-muted small">{{ user.id }}</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle {{ user.isAdmin ? 'bg-warning' : 'bg-primary' }} d-flex align-items-center justify-content-center"
                             style="width:32px;height:32px;min-width:32px;">
                            <span class="{{ user.isAdmin ? 'text-dark' : 'text-white' }} fw-bold small">{{ user.firstName[0] }}</span>
                        </div>
                        <span class="fw-semibold">{{ user.fullName }}</span>
                    </div>
                </td>
                <td class="small text-muted">{{ user.email }}</td>
                <td>
                    {% if user.isAdmin %}
                        <span class="badge bg-warning text-dark"><i class="bi bi-shield-fill"></i> Admin</span>
                    {% else %}
                        <span class="badge bg-primary">Utilisateur</span>
                    {% endif %}
                </td>
                <td>
                    {% if user.isActive %}
                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Actif</span>
                    {% else %}
                        <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Inactif</span>
                    {% endif %}
                </td>
                <td class="text-muted small">{{ user.createdAt|date('d/m/Y') }}</td>
                <td>
                    {% if not user.isAdmin %}
                    <form method="post" action="{{ path('admin_user_toggle', {id: user.id}) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_user_' ~ user.id) }}">
                        <button class="btn btn-sm {{ user.isActive ? 'btn-outline-warning' : 'btn-outline-success' }}"
                                title="{{ user.isActive ? 'Désactiver' : 'Activer' }}">
                            <i class="bi bi-{{ user.isActive ? 'pause-circle' : 'play-circle' }}"></i>
                            {{ user.isActive ? 'Désactiver' : 'Activer' }}
                        </button>
                    </form>
                    {% else %}
                        <span class="text-muted small">—</span>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7" class="text-center text-muted py-4">Aucun utilisateur</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
