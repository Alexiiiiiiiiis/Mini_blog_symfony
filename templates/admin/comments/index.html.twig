{% extends 'admin/base.html.twig' %}

{% block title %}Commentaires — Admin{% endblock %}
{% block page_title %}Modération des commentaires{% endblock %}

{% block content %}
<h5 class="mb-4 fw-bold">{{ comments|length }} commentaire(s)</h5>

<div class="card">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Auteur</th>
                <th>Commentaire</th>
                <th>Article</th>
                <th>Statut</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for comment in comments %}
            <tr>
                <td class="text-muted small">{{ comment.id }}</td>
                <td class="small fw-semibold">{{ comment.author.fullName }}</td>
                <td>
                    <span class="small">{{ comment.content|slice(0, 60) }}{% if comment.content|length > 60 %}...{% endif %}</span>
                </td>
                <td>
                    <a href="{{ path('app_post_show', {id: comment.post.id}) }}" class="small text-decoration-none" target="_blank">
                        {{ comment.post.title|slice(0, 30) }}...
                    </a>
                </td>
                <td>
                    {% if comment.status == 'approved' %}
                        <span class="badge bg-success">Approuvé</span>
                    {% elseif comment.status == 'pending' %}
                        <span class="badge bg-warning text-dark">En attente</span>
                    {% else %}
                        <span class="badge bg-danger">Rejeté</span>
                    {% endif %}
                </td>
                <td class="text-muted small">{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                <td>
                    <form method="post" action="{{ path('admin_comment_toggle', {id: comment.id}) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_comment_' ~ comment.id) }}">
                        <button class="btn btn-sm {{ comment.status == 'approved' ? 'btn-outline-warning' : 'btn-outline-success' }}" title="Changer le statut">
                            <i class="bi bi-{{ comment.status == 'approved' ? 'x' : 'check' }}"></i>
                        </button>
                    </form>
                    <form method="post" action="{{ path('admin_comment_delete', {id: comment.id}) }}" class="d-inline"
                          onsubmit="return confirm('Supprimer ce commentaire ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7" class="text-center text-muted py-4">Aucun commentaire</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
