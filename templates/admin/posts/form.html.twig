{% extends 'admin/base.html.twig' %}

{% block title %}{{ title }} — Admin{% endblock %}
{% block page_title %}{{ title }}{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="mb-0 fw-bold">{{ title }}</h5>
                <a href="{{ path('admin_posts') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
            </div>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="mb-3">
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title) }}
                    <div class="text-danger small">{{ form_errors(form.title) }}</div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.category) }}
                    {{ form_widget(form.category) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.picture) }}
                    {{ form_widget(form.picture) }}
                    <div class="form-text">URL de l'image de couverture (optionnel)</div>
                    {% if post is defined and post.picture %}
                        <img src="{{ post.picture }}" class="mt-2 rounded" style="max-height: 150px;">
                    {% endif %}
                </div>
                <div class="mb-4">
                    {{ form_label(form.content) }}
                    {{ form_widget(form.content) }}
                    <div class="text-danger small">{{ form_errors(form.content) }}</div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Enregistrer
                    </button>
                    <a href="{{ path('admin_posts') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
