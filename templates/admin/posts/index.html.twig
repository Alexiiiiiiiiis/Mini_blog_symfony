{% extends 'admin/base.html.twig' %}

{% block title %}Articles — Admin{% endblock %}
{% block page_title %}Gestion des articles{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0 fw-bold">{{ posts|length }} article(s)</h5>
    <a href="{{ path('admin_post_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvel article
    </a>
</div>

<div class="card">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Titre</th>
                <th>Auteur</th>
                <th>Catégorie</th>
                <th>Commentaires</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for post in posts %}
            <tr>
                <td class="text-muted small">{{ post.id }}</td>
                <td>
                    <span class="fw-semibold">{{ post.title|slice(0, 40) }}{% if post.title|length > 40 %}...{% endif %}</span>
                </td>
                <td class="small">{{ post.author.fullName }}</td>
                <td>
                    {% if post.category %}
                        <span class="badge bg-primary">{{ post.category.name }}</span>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                </td>
                <td class="text-center">
                    <span class="badge bg-light text-dark">{{ post.comments|length }}</span>
                </td>
                <td class="text-muted small">{{ post.publishedAt|date('d/m/Y') }}</td>
                <td>
                    <a href="{{ path('app_post_show', {id: post.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir" target="_blank">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="{{ path('admin_post_edit', {id: post.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                        <i class="bi bi-pencil"></i>
                    </a>
                    
                    {# Bouton qui ouvre la modal au lieu du confirm JavaScript #}
                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ post.id }}" title="Supprimer">
                        <i class="bi bi-trash"></i>
                    </button>

                    {# Modal de confirmation pour chaque article #}
                    <div class="modal fade" id="deleteModal{{ post.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ post.id }}" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header border-0">
                                    <h5 class="modal-title fw-bold" id="deleteModalLabel{{ post.id }}">
                                        <i class="bi bi-exclamation-triangle-fill text-danger"></i> Confirmer la suppression
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="mb-2">Êtes-vous sûr de vouloir supprimer cet article ?</p>
                                    <div class="alert alert-light border">
                                        <small class="text-muted d-block mb-1"><strong>Titre :</strong> {{ post.title }}</small>
                                        <small class="text-muted d-block mb-1"><strong>Auteur :</strong> {{ post.author.fullName }}</small>
                                        <small class="text-muted"><strong>Date :</strong> {{ post.publishedAt|date('d/m/Y') }}</small>
                                    </div>
                                    {% if post.comments|length > 0 %}
                                        <div class="alert alert-warning">
                                            <i class="bi bi-exclamation-triangle"></i> Cet article contient <strong>{{ post.comments|length }} commentaire(s)</strong> qui seront également supprimés.
                                        </div>
                                    {% endif %}
                                    <p class="text-danger small mb-0">
                                        <i class="bi bi-info-circle"></i> Cette action est <strong>irréversible</strong>.
                                    </p>
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <i class="bi bi-x-circle"></i> Annuler
                                    </button>
                                    <form method="post" action="{{ path('admin_post_delete', {id: post.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="bi bi-trash-fill"></i> Supprimer définitivement
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7" class="text-center text-muted py-4">Aucun article</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
