{% extends 'admin/base.html.twig' %}

{% block title %}Catégories — Admin{% endblock %}
{% block page_title %}Gestion des catégories{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0 fw-bold">{{ categories|length }} catégorie(s)</h5>
    <a href="{{ path('admin_category_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvelle catégorie
    </a>
</div>

<div class="card">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Articles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td class="text-muted small">{{ category.id }}</td>
                <td class="fw-semibold">{{ category.name }}</td>
                <td class="small text-muted">{{ category.description|slice(0, 50) }}{% if category.description|length > 50 %}...{% endif %}</td>
                <td class="text-center">
                    <span class="badge bg-light text-dark">{{ category.posts|length }}</span>
                </td>
                <td>
                    <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                        <i class="bi bi-pencil"></i>
                    </a>
                    
                    {# Bouton qui ouvre la modal au lieu du confirm JavaScript #}
                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ category.id }}" title="Supprimer">
                        <i class="bi bi-trash"></i>
                    </button>

                    {# Modal de confirmation pour chaque catégorie #}
                    <div class="modal fade" id="deleteModal{{ category.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ category.id }}" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header border-0">
                                    <h5 class="modal-title fw-bold" id="deleteModalLabel{{ category.id }}">
                                        <i class="bi bi-exclamation-triangle-fill text-danger"></i> Confirmer la suppression
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="mb-2">Êtes-vous sûr de vouloir supprimer cette catégorie ?</p>
                                    <div class="alert alert-light border">
                                        <small class="text-muted d-block mb-1"><strong>Nom :</strong> {{ category.name }}</small>
                                        <small class="text-muted"><strong>Description :</strong> {{ category.description }}</small>
                                    </div>
                                    {% if category.posts|length > 0 %}
                                        <div class="alert alert-warning">
                                            <i class="bi bi-exclamation-triangle"></i> Cette catégorie contient <strong>{{ category.posts|length }} article(s)</strong>. La suppression affectera ces articles.
                                        </div>
                                    {% endif %}
                                    <p class="text-danger small mb-0">
                                        <i class="bi bi-info-circle"></i> Cette action est <strong>irréversible</strong>.
                                    </p>
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <i class="bi bi-x-circle"></i> Annuler
                                    </button>
                                    <form method="post" action="{{ path('admin_category_delete', {id: category.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="bi bi-trash-fill"></i> Supprimer définitivement
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="text-center text-muted py-4">Aucune catégorie</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
